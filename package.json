{
  "name": "api-athenet-chat",
  "version": "0.1.0",
  "description": "Chat en vivo de Athenet",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/index.js",
    "start": "node src/index.js",
    "test": "node --test --env-file-if-exists=.env \"test/*.test.js\"",
    "migrate": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up",
    "migrate:down": "node --env-file=.env ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down",
    "migrate:create": "node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create -j sql --migration-filename-format index",
    "migrate:prod": "node ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up"
  },
  "license": "ISC",
  "dependencies": {
    "express": "^5.3.0",
    "jose": "^6.2.17",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "ws": "^8.22.2"
  }
}
