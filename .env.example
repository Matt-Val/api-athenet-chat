PORT=8086

# node-pg-migrate y el pool de pg leen esta misma URL: una sola fuente de verdad
# para la conexion, en vez de cinco variables sueltas como en los servicios Java.
DATABASE_URL=postgresql://chat_user:REEMPLAZAR_PASSWORD@localhost:5436/chat_db
# Solo lo consume docker-compose para inicializar el contenedor de Postgres.
DB_PASSWORD=REEMPLAZAR_PASSWORD

COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/REEMPLAZAR_USER_POOL_ID
COGNITO_CLIENT_ID=REEMPLAZAR_APP_CLIENT_ID
COGNITO_USERINFO_URI=https://REEMPLAZAR_DOMINIO.auth.us-east-1.amazoncognito.com/oauth2/userInfo

# Origenes permitidos para el handshake del WebSocket (separados por coma).
WS_ALLOWED_ORIGINS=http://localhost:5173
# Vida del ticket de un solo uso. Corta a proposito: solo tiene que durar lo que
# tarda el navegador en abrir el WebSocket despues de pedirlo.
WS_TICKET_TTL_SECONDS=30
