# Plantilla para /opt/athenet/chat.env en la EC2.
# Se pasa con docker --env-file: sin export, sin comillas envolventes.
PORT=8086

# El endpoint del RDS cambia cada vez que se recrea la instancia, por eso va como
# placeholder. A 2026-11-16 el endpoint vivo es:
#   athenet-db.cvs02nytunlu.us-east-1.rds.amazonaws.com
# uselibpqcompat=true es obligatorio contra RDS: desde pg 8.23, sslmode=require
# por si solo equivale a verify-full, que exige verificar el certificado del
# servidor contra las CAs que Node trae de fabrica. El de RDS lo firma la CA
# propia de Amazon, que no esta en esa lista, y la conexion falla con
# SELF_SIGNED_CERT_IN_CHAIN. Con uselibpqcompat, "require" vuelve a significar
# lo de siempre: cifrar sin verificar, igual que el driver JDBC de los otros
# microservicios.
DATABASE_URL=postgresql://chat_user:REEMPLAZAR_PASSWORD_CHAT@REEMPLAZAR_ENDPOINT_RDS:5432/chat_db?uselibpqcompat=true&sslmode=require

# El client va a ser el mismo App Client que usa la web: VITE_COGNITO_CLIENT_ID
# userInfo solo se usa con tokens de Hosted UI dev-client
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/REEMPLAZAR_USER_POOL_ID
COGNITO_CLIENT_ID=REEMPLAZAR_APP_CLIENT_ID
COGNITO_USERINFO_URI=https://REEMPLAZAR_DOMINIO.auth.us-east-1.amazoncognito.com/oauth2/userInfo

# Origenes permitidos para el handshake del WebSocket y para el preflight del
# ticket. Es la misma lista para los dos; separar por comas si hay varios.
# El Origin no lleva ruta: para GitHub Pages es https://<usuario>.github.io
WS_ALLOWED_ORIGINS=https://REEMPLAZAR_FRONT

WS_TICKET_TTL_SECONDS=30
